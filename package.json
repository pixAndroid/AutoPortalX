{
  "name": "autoflowx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "pnpm --filter @autoflowx/db generate",
    "db:migrate": "pnpm --filter @autoflowx/db migrate:dev",
    "db:push": "pnpm --filter @autoflowx/db db:push"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": { "node": ">=18" }
}
